<div id=<%=dom_id(project)%> class='flex flex-row'>
<div class='w-full my-5 space-y-5'>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= project.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Users:</strong>
    <%= project.users %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Completed at:</strong>
    <%= project.completed_at %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Scheduled at:</strong>
    <%= project.scheduled_at %>
  </div>
</div>
<div class="">
  <%= link_to "Edit", edit_project_path(project), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy", project, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?", turbo_method: :delete } %>
</div>
</div>
