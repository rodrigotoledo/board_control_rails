<% content_for :title, "Projects" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Projects</h1>
  </div>

  <h2 class="font-bold text-2xl">New Project</h2>
  <%= render "form", project: (@project || Project.new) %>
  <hr class="my-4" />

  <%=turbo_stream_from :projects %>
  <%= turbo_frame_tag :projects do %>
    <div class="min-w-full divide-y divide-gray-200 space-y-5">
      <% if @projects.any? %>
        <%= render partial: 'projects/list_of_projects', locals: {projects: @projects} %>
      <% else %>
        <p class="text-center my-10">No projects found.</p>
      <% end %>
    </div>
  <% end %>
</div>
